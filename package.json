{
  "name": "@juncta/sdk",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript SDK for Juncta: quotes, routes, transaction building and relay submission.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junctaxyz/juncta-sdk.git"
  },
  "homepage": "https://github.com/junctaxyz/juncta-sdk#readme",
  "bugs": {
    "url": "https://github.com/junctaxyz/juncta-sdk/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.11 <25"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "docs": "typedoc",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
